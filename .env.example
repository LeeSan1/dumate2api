# Optional explicit values. By default the proxy discovers these from the
# running DuMate desktop process on macOS.
DUMATE_BACKEND_HOST=127.0.0.1
# DUMATE_BACKEND_PORT=12345
# DUMATE_INAPP_KEY=do-not-commit-this-value

# Proxy listener. Keep this on loopback unless you add authentication yourself.
DUMATE_PROXY_HOST=127.0.0.1
DUMATE_PROXY_PORT=3066

# The DuMate local OpenAI-compatible API prefix.
DUMATE_UPSTREAM_PREFIX=/api/qianfanproxy/v1

# Set to 1 only when you intentionally want to route bare model names such as
# deepseek-v4-pro. The default avoids stealing traffic from other providers.
DUMATE_ROUTE_BARE_MODELS=0

# Set to 1 to pass through an alias that is not in the built-in catalog.
# The value sent upstream is the normalized alias.
DUMATE_ALLOW_UNKNOWN_MODELS=0
